PORT=5000
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=1d
FRONTEND_URL=http://localhost:5173
# Your Groq API key
GROQ_API_KEY=YOUR_API_KEY_HERE

# Groq model to try first, followed by comma-separated fallbacks
GENAI_MODEL=llama-3.3-70b-versatile
GENAI_FALLBACK_MODELS=llama-3.1-8b-instant

# Note: Do NOT commit real secrets to git. Use .env locally and set
# production env vars securely in your deployment environment.
